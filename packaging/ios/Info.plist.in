<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: `cargo xtask ios --bundle` substitutes @VERSION@ (full, e.g. 0.7.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z), @BUILD_SHA@ and @PLATFORM@ (iphoneos or iphonesimulator). -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>CADCraft</string>
  <key>CFBundleName</key>
  <string>CADCraft</string>
  <key>CFBundleExecutable</key>
  <string>cadcraft-ios</string>
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.cadcraft</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>CADCraftVersion</key>
  <string>@VERSION@</string>
  <key>CADCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleSupportedPlatforms</key>
  <array><string>@PLATFORM@</string></array>
  <key>CFBundleIcons</key>
  <dict>
    <key>CFBundlePrimaryIcon</key>
    <dict>
      <key>CFBundleIconFiles</key>
      <array><string>AppIcon</string></array>
    </dict>
  </dict>
  <key>CFBundleIcons~ipad</key>
  <dict>
    <key>CFBundlePrimaryIcon</key>
    <dict>
      <key>CFBundleIconFiles</key>
      <array><string>AppIcon</string></array>
    </dict>
  </dict>
  <!-- Must match IPHONEOS_DEPLOYMENT_TARGET in xtask/src/ios.rs. iPadOS 15 has the Metal
       feature set wgpu targets and runs on every iPad that runs iPadOS 17. -->
  <key>MinimumOSVersion</key>
  <string>15.0</string>
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <!-- iPad only: the drafting interface needs the room. -->
  <key>UIDeviceFamily</key>
  <array><integer>2</integer></array>
  <key>UIRequiredDeviceCapabilities</key>
  <array><string>arm64</string><string>metal</string></array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
  </array>
  <!-- Full screen, no status bar: the drawing area gets every point; the home indicator is
       avoided through the safe area egui reports. -->
  <key>UIStatusBarHidden</key>
  <true/>
  <!-- Without this, winit's view controller decides (it answers "not hidden") and the status bar
       covers the quick access toolbar. -->
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <false/>
  <key>UIRequiresFullScreen</key>
  <false/>
  <key>UILaunchScreen</key>
  <dict/>
  <!-- The Documents folder shows in the Files app as On My iPad > CADCraft (src/documents.rs). -->
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the CADCraft authors. MIT OR Apache-2.0.</string>

  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.cadcraft.dxf</string>
      <key>UTTypeDescription</key>
      <string>Drawing Exchange Format</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>dxf</string></array>
        <key>public.mime-type</key>
        <array><string>image/vnd.dxf</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.cadcraft.dwg</string>
      <key>UTTypeDescription</key>
      <string>Drawing</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>dwg</string></array>
        <key>public.mime-type</key>
        <array><string>image/vnd.dwg</string></array>
      </dict>
    </dict>
  </array>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Drawing Exchange Format</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array><string>ai.storyteller.cadcraft.dxf</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Drawing</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array><string>ai.storyteller.cadcraft.dwg</string></array>
    </dict>
  </array>
</dict>
</plist>
